# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Никогда не коммитьте его в репозиторий.
BOT_TOKEN=
# Имя бота без @ — нужно для ссылки «Открыть бота» на экране входа.
BOT_USERNAME=

# ─── Веб-панель ──────────────────────────────────────────────────────────────
PORT=3000
# Публичный адрес панели (https). Нужен для ссылок входа и Mini App.
# Локально можно оставить пустым — подставится http://localhost:PORT
PUBLIC_URL=
# Секрет для подписи сессионных cookie. Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_DAYS=30

# ─── Данные ──────────────────────────────────────────────────────────────────
# Файл SQLite. На хостинге укажите путь на постоянном диске, например /data/kopeyka.db
DB_PATH=./data/kopeyka.db
DEFAULT_CURRENCY=UZS
# Часовой пояс по умолчанию в минутах от UTC: 300 = UTC+5 (Ташкент), 180 = UTC+3
DEFAULT_TZ_OFFSET=300
# Необязательно: свои курсы валют (сколько единиц валюты в одном долларе)
# RATES={"USD":1,"UZS":12600,"RUB":92}

# ─── Режим получения апдейтов ────────────────────────────────────────────────
# По умолчанию long polling — работает везде и без публичного адреса.
# Для вебхука: USE_WEBHOOK=1 и обязательный PUBLIC_URL (https).
USE_WEBHOOK=0
WEBHOOK_SECRET=

# ─── Необязательно: распознавание чеков по фото ──────────────────────────────
# Без ключа бот просто попросит ввести сумму текстом.
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5
