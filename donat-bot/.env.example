# Telegram bot token from @BotFather
BOT_TOKEN=
# Shop name shown in the bot and Mini App (change any time)
SHOP_NAME=ALI DONAT TJ
# Public HTTPS address where this server is reachable (Mini App). Example: https://donat.example.com
WEBAPP_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Admin Telegram IDs, comma separated. Optionally a group chat for admin notifications
ADMIN_IDS=
ADMIN_CHAT_ID=
SUPPORT_URL=https://t.me/your_support
REVIEWS_URL=https://t.me/your_reviews_channel
# 1 RUB = X TJS
RUB_RATE=0.1073
REFERRAL_PERCENT=3

# Card numbers shown to customers (easier: set them in the bot, /panel → Реквизитҳо)
ALIF_CARD=
ALIF_PAY_URL=
DC_CARD=
DC_PAY_URL=
OTHER_CARD=
RUS_CARD=
ATM_CARD=

# Donatix API for automatic delivery (empty = manual delivery by admins). Keep the key secret.
SUPPLIER_API_URL=https://donatix.tj/api/v1
SUPPLIER_API_KEY=
# Donatix prices are in USD: shop price = price_usd x USD_RATE x (1 + MARKUP_PERCENT/100), rounded up to 0.10.
# Both can be changed in /panel; the rate is taken from Donatix automatically when available.
USD_RATE=11.0
MARKUP_PERCENT=15
# Requests per minute to Donatix (its limits: 60 orders, 120 status checks, 60 account checks); extra orders wait
SUPPLIER_ORDERS_PER_MIN=50
SUPPLIER_STATUS_PER_MIN=100
SUPPLIER_ACCOUNT_PER_MIN=50
# Optional: webhook secret from Donatix panel → API (webhook URL: https://<your domain>/api/donatix-hook)
DONATIX_WEBHOOK_SECRET=
# One-time code for the owner link (the installer generates it): https://t.me/<bot>?start=owner_<code>
OWNER_CODE=
